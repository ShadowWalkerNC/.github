{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shadowwalker:portfolio:v1",
  "title": "ShadowWalker portfolio registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "owner",
    "blueprintVersion",
    "stateSemantics",
    "activeProjectIds",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "const": "ShadowWalkerNC"
    },
    "blueprintVersion": {
      "type": "string"
    },
    "capturedAt": {
      "type": "string"
    },
    "stateSemantics": {
      "type": "string",
      "minLength": 1
    },
    "activeProjectIds": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unlocatedLabIdeas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "entityKind",
        "classification",
        "lifecycle",
        "stateKind",
        "ownership",
        "defaultView",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entityKind": {
          "enum": [
            "repository",
            "project",
            "package",
            "workspace"
          ]
        },
        "classification": {
          "enum": [
            "platform",
            "product",
            "module",
            "infrastructure",
            "client",
            "lab",
            "reference",
            "migration-source",
            "absorbed",
            "archive"
          ]
        },
        "lifecycle": {
          "enum": [
            "planned-active",
            "active",
            "supporting",
            "migrating",
            "paused",
            "deprecated",
            "read-only",
            "archived"
          ]
        },
        "stateKind": {
          "const": "portfolio-designation"
        },
        "ownership": {
          "enum": [
            "ShadowWalkerNC",
            "external/upstream"
          ]
        },
        "defaultView": {
          "enum": [
            "Active",
            "Labs",
            "References",
            "Archive",
            "Migrations",
            "Supporting"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        },
        "ecosystem": {
          "type": "string"
        },
        "observed": {
          "type": "object"
        },
        "baseline": {
          "type": [
            "object",
            "null"
          ]
        },
        "migration": {
          "type": [
            "object",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "repositoryOwner": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "internal"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}