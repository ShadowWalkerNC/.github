{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability registry v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inventoryComplete": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Capability",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "source-observed",
              "planned",
              "validated"
            ]
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "description",
          "owner",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "inventoryComplete",
    "capabilities"
  ],
  "additionalProperties": false
}