{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceCounts": {
      "type": "object",
      "properties": {
        "inventory": {
          "type": "integer",
          "minimum": 0
        },
        "ecosystem": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "inventory",
        "ecosystem"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "inventory",
              "ecosystem"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "targetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "enum": [
              "included-public",
              "withheld-no-public-approval"
            ]
          },
          "sourcePosition": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source",
          "sourceId",
          "targetId",
          "disposition",
          "sourcePosition"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "sourceCounts",
    "rows"
  ],
  "additionalProperties": false
}
