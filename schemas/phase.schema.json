{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase contract v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "blocked"
      ]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[0-9]{2}$"
      }
    },
    "repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_approval": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permission_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "depends_on",
    "repositories",
    "allowed_actions",
    "requires_approval",
    "exit_criteria",
    "permission_note"
  ],
  "additionalProperties": false
}