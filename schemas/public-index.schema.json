{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "const": "ShadowWalkerNC"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github.com/"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "intendedLifecycle": {
            "type": "string",
            "minLength": 1
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            },
            "uniqueItems": true
          },
          "verification": {
            "const": "historical-observations-only"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "inventory",
                    "ecosystem"
                  ]
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "category": {
                  "type": "string",
                  "minLength": 1
                },
                "intendedLifecycle": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "sourceId",
                "observedAt",
                "category",
                "intendedLifecycle"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "repository",
          "url",
          "category",
          "intendedLifecycle",
          "observedAt",
          "evidence",
          "verification",
          "observations"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "owner",
    "entries"
  ],
  "additionalProperties": false
}
