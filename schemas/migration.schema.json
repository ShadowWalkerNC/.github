{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shadowwalker:migration:v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "status",
    "sources",
    "globalGates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned_not_executed",
        "in_progress",
        "complete"
      ]
    },
    "globalGates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "target",
          "strategy",
          "finalState",
          "phase"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "gradual",
              "gradual-polyglot",
              "absorbed",
              "concepts-only",
              "selective",
              "rename",
              "archive",
              "conditional-archive"
            ]
          },
          "finalState": {
            "enum": [
              "active",
              "archived"
            ]
          },
          "phase": {
            "type": "string",
            "pattern": "^P[0-9]{2}(?:-[A-E])?$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "condition": {
            "type": "string"
          },
          "requiresApproval": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "complete",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
